# ---------------------------------------------------------------------------
# Kept — environment configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL. Neon example: postgres://user:pass@ep-xxx.neon.tech/kept?sslmode=require
DATABASE_URL=postgres://postgres@localhost:5433/kept
# Used only by the test suite (it is wiped between runs).
TEST_DATABASE_URL=postgres://postgres@localhost:5433/kept_test

# Public base URL of this deployment (used for receipt links and PayPal return URLs).
APP_BASE_URL=http://localhost:3000

# --- PayPal (sandbox) -------------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client id, exposed to the browser for the PayPal JS SDK (client id is public by design).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Webhook id from the app's Webhooks section (needed for signature verification).
# Create it with `npm run paypal:webhook:register` once APP_BASE_URL is public HTTPS.
PAYPAL_WEBHOOK_ID=

# --- AI (Anthropic Claude) --------------------------------------------------
# Without a key, Kept runs its clearly-labelled deterministic fallbacks
# (scripted demo assistant + rule-based extractor + rule-based remedy).
ANTHROPIC_API_KEY=
KEPT_AI_MODEL=claude-opus-5-5

# --- Merchant demo access ---------------------------------------------------
# Single shared passcode for the merchant console. DEMO ONLY — not production auth.
MERCHANT_PASSCODE=change-me
# Secret used to sign the merchant session cookie (32+ random bytes, hex).
SESSION_SECRET=

# --- Demo controls ----------------------------------------------------------
# Enables the labelled "simulated clock" and the demo pricing scenario in the store.
DEMO_MODE=true
# Minutes after which a missing capture/refund webhook triggers authoritative GET reconciliation.
RECONCILE_AFTER_MINUTES=2
# Shared secret for the reconcile endpoint (called by a cron job / Render cron).
CRON_SECRET=

# Optional: AG Studio licence key for /merchant/analytics (runs in evaluation mode without it)
AG_STUDIO=
