# Envelope configuration. Copy to .env for local development. Never commit real values.

# Postgres. Leave DATABASE_URL unset on a host (for example Vercel) and the app becomes a try-it copy:
# the gateway runs in the visitor's browser against the PayPal simulator, and every page says so.
DATABASE_URL=postgres://postgres@localhost:5433/kept
TEST_DATABASE_URL=postgres://postgres@localhost:5433/kept_test
DB_POOL_MAX=5

# Public URL of the app (optional locally)
APP_BASE_URL=http://localhost:3000

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave both empty to run on the built-in, clearly labelled simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox only: a test card number to try first when placing a hold (see developer.paypal.com/tools/sandbox/card-testing).
# PAYPAL_SANDBOX_TEST_CARD=
# Force a mode: sandbox | simulated
# PAYPAL_MODE=

# Events from PayPal (optional). Register a webhook for the sandbox app pointing at
# https://<your host>/api/paypal/webhook and put its id here. Without an id, events are not accepted.
# PAYPAL_WEBHOOK_ID=
# A scheduler calling POST /api/sweep must send this as "Authorization: Bearer <value>" (optional; Vercel Cron does).
# CRON_SECRET=

# Seals the private keys the gateway stores (its signing key, demo agents' keys) before they reach the
# database. At least 24 characters. Leave empty and they are stored as plain JWK; /api/health reports which.
ENVELOPE_KEY_SECRET=

# Sandbox accounts that receive the demo payouts (optional).
# Addresses without a sandbox account are reported by PayPal as UNCLAIMED.
ENVELOPE_PAYEE_1=
ENVELOPE_PAYEE_2=

# Serverless hosts only: keep simulator state in Postgres between instances
# ENVELOPE_SIM_PERSIST=1

# A language model that plays the demo agents live (optional). Any OpenAI-compatible endpoint.
# No key? `node scripts/claude-bridge.mjs` serves one on http://localhost:8787/v1 from a Claude Code login.
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=

# Which financial rail moves money (lib/rails). "paypal" (default) or "mock" (deterministic, no network:
# contract tests and offline development only). An unknown value is refused at startup, never fallback.
# ENVELOPE_RAIL_PROVIDER=paypal

# Whose money backs a payout. Required in production: the gateway refuses to pay (503) while this is unset.
#   pooled    = one provider account holds every organization's money; the operator owes each balance and
#               carries the float risk. Not segregated or safeguarded custody.
#   allocated = each organization's payout is also checked against its own provider position (needs one
#               provider account per organization). Fails closed.
# ENVELOPE_TREASURY_MODE=pooled

# How long one arrival may own a settlement before another may take it over, in ms (default 30000, floor 5000).
# The claim is renewed while work continues; a takeover fences the old worker out.
# SETTLEMENT_LEASE_MS=30000

# The webhook endpoint's id at that provider. PayPal's dashboard calls it a webhook id.
# PAYPAL_WEBHOOK_ID is still read for existing deployments; this is the neutral name.
# ENVELOPE_WEBHOOK_ID=
