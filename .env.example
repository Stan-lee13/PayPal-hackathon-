# MergePay configuration. Copy to .env for local development. Never commit real values.

# --- Database (Postgres) ---
DATABASE_URL=postgres://postgres@localhost:5433/kept
TEST_DATABASE_URL=postgres://postgres@localhost:5433/kept_test
# On serverless hosts keep this at 1
DB_POOL_MAX=5

# Public URL (webhooks, payer links). On Vercel it defaults to the production domain.
APP_BASE_URL=http://localhost:3000

# --- PayPal (sandbox) --- leave both empty to use the built-in, clearly labelled simulator
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From `npm run paypal:webhook:register` (subscribes INVOICING.INVOICE.* events)
PAYPAL_WEBHOOK_ID=
# Force a mode: sandbox | live | simulated (default: sandbox if credentials exist)
# PAYPAL_MODE=

# --- GitHub --- leave empty to use the simulated repository
# Fine-grained token for ONE demo repo: Contents, Issues, Pull requests = read & write
MERGEPAY_GITHUB_TOKEN=
# The repository the demo contract covers, owner/name
DEMO_REPO=
# GITHUB_MODE=live | simulated

# --- Who gets the demo invoice --- in sandbox: your sandbox *personal* (buyer) account email
DEMO_CLIENT_EMAIL=

# --- Editor access (MCP) --- any long random string; only its SHA-256 is stored
MERGEPAY_MCP_TOKEN=

# --- Dashboard sign-in (demo) ---
MERGEPAY_PASSCODE=change-me
SESSION_SECRET=

# --- AI (optional) --- without a key the rules write descriptions and the scope check
ANTHROPIC_API_KEY=
MERGEPAY_AI_MODEL=claude-opus-5-5
MERGEPAY_AI_DAILY_BUDGET_USD=2

# Serverless hosts: keep simulator state in Postgres between instances
MERGEPAY_SIM_PERSIST=1
