# Envelope configuration. Copy to .env for local development. Never commit real values.

# Postgres
DATABASE_URL=postgres://postgres@localhost:5433/kept
TEST_DATABASE_URL=postgres://postgres@localhost:5433/kept_test
DB_POOL_MAX=5

# Public URL of the app (optional locally)
APP_BASE_URL=http://localhost:3000

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave both empty to run on the built-in, clearly labelled simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Force a mode: sandbox | simulated
# PAYPAL_MODE=

# Sandbox accounts that receive the demo payouts (optional).
# Addresses without a sandbox account are reported by PayPal as UNCLAIMED.
ENVELOPE_PAYEE_1=
ENVELOPE_PAYEE_2=

# Serverless hosts only: keep simulator state in Postgres between instances
# ENVELOPE_SIM_PERSIST=1
